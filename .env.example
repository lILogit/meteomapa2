# Meteomapa configuration. Copy to .env and adjust.

# Detection center (South Bohemia by default)
CENTER_LAT=48.9086
CENTER_LON=14.5948

# Sampling radius around the center (km)
RADIUS_KM=12

# Number of past observed (5-min) frames to show in the timeline (max ~288 = 24h)
HISTORY_FRAMES=12

# Include +10..+60 min nowcast frames
INCLUDE_FORECAST=true

# Data refresh interval (seconds). CHMI publishes every 5 min (300s).
REFRESH_SECONDS=300

# Status panel poll interval (seconds)
STATUS_REFRESH_SECONDS=60

# Directory listing freshness TTL (seconds)
CACHE_TTL_LISTING=60

# Disk cache root (immutable frame files live here)
CACHE_DIR=./data_cache

# CHMI opendata base (radar composites)
CHMI_OPENDATA=https://opendata.chmi.cz/meteorology/weather/radar/composite

# Server
PORT=8000
LOG_LEVEL=INFO

# --- Telegram bot + background monitor (optional) ---
# Create a bot with @BotFather and paste its token here to enable proactive alerts.
# Empty = bot disabled (the web app still works). Put REAL secrets in .env, not here.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram account ID (message @userinfobot to get it). 0/empty = allow anyone.
TELEGRAM_CHAT_ID=
# Seconds between proactive checks of each monitored point
TELEGRAM_MONITOR_INTERVAL=120
# Min seconds between non-escalating alerts (prevents spam)
TELEGRAM_NOTIFY_COOLDOWN=600
# Resolve place names (e.g. "home", "České Budějovice") via OpenStreetMap Nominatim
GEOCODE_ENABLED=true

# --- Deployment (Docker / Traefik on Hostinger) ---
# Consumed by docker-compose.yml for ${...} interpolation. Set real values in .env on the server.
# Set EXACTLY ONE of TRAEFIK_HOST / DOMAIN_NAME. Both empty = compose refuses to
# deploy (rather than serving the malformed host `meteomapa.`).
#
# TRAEFIK_HOST — shared base domain from Hostinger's Traefik project. The app is then
# served at <compose-project>.<TRAEFIK_HOST>, e.g. meteomapa.srv123.hstgr.cloud, which
# needs no per-project DNS if that base domain has a wildcard A record.
TRAEFIK_HOST=
# DOMAIN_NAME — custom fqdn instead; wins over TRAEFIK_HOST when set. Its A record must
# point at the VPS BEFORE the first request or the ACME challenge fails.
DOMAIN_NAME=
# Let's Encrypt contact address. Only docker-compose.standalone.yml reads this — with
# Hostinger's shared proxy, that project owns the ACME account and this stays empty.
SSL_EMAIL=
TZ=Europe/Prague
# Shared Traefik network created by Hostinger's Traefik project template.
# Change only if that project uses a different network name.
TRAEFIK_NETWORK=traefik-proxy
# Certificate resolver defined by the proxy. Hostinger's template calls it `letsencrypt`;
# the bundled standalone traefik defines the same name, so this rarely changes.
TRAEFIK_CERTRESOLVER=letsencrypt
